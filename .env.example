# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Shopify: solo en el servidor. Completar credenciales al autorizar la app.
SHOPIFY_STORE_DOMAIN=1c76bc-08.myshopify.com
SHOPIFY_API_VERSION=2026-10
SHOPIFY_SYNC_INTERVAL_MINUTES=10
BOLT_SHOPIFY_SNAPSHOT_PATH=.bolt-private/shopify/snapshot.json

# App y tienda de la misma organizacion: usar este par de credenciales.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Otra organizacion: token obtenido mediante OAuth y mantenido fuera de este runtime.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Token propio de administracion para POST /api/v1/shopify/sync, nunca en React.
# Generar al menos 32 bytes aleatorios; no reutilizar una clave de Shopify.
BOLT_ADMIN_API_TOKEN=
# Firma webhook: si esta vacio, se usa SHOPIFY_CLIENT_SECRET.
SHOPIFY_WEBHOOK_SECRET=

# VITE_GOOGLE_MAPS_API_KEY: Public key for Google Maps Javascript API
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
