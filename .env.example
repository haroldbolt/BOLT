# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Maps JavaScript para el navegador. Restringir a los dominios de BOLT.
VITE_GOOGLE_MAPS_API_KEY=""
# Identificador de mapa para los marcadores de seguimiento. DEMO_MAP_ID sirve en pruebas.
VITE_GOOGLE_MAPS_TRACKING_MAP_ID=""
# ID web de Google Maps para el selector de dirección. Vacío usa el mapa de calles con marcadores estándar.
VITE_GOOGLE_MAPS_ADDRESS_MAP_ID=""
# Clave de geocodificación del servidor. Configurar como secreto del entorno.
GOOGLE_MAPS_SERVER_API_KEY=""

# Alta inicial de personal. La autorización se prepara de forma explícita para una sola instalación.
# Configura estos valores en el despliegue. El directorio de control debe ser privado, persistente
# y estar fuera del volumen de datos. BOLT_ADMIN_VOLUME_DIR identifica ese volumen fuera del lanzador del piloto.
BOLT_ADMIN_INSTALLATION_ID=""
BOLT_ADMIN_CONTROL_DIR=""
# En un despliegue con un disco, publicar el recibo de cierre desde el gestor de secretos.
# BOLT_ADMIN_CLOSED_RECEIPT=""
BOLT_ADMIN_VOLUME_DIR=""
# Correo de la cuenta autorizada durante la preparación. El token de alta se entrega por un canal privado.
BOLT_ADMIN_BOOTSTRAP_EMAIL=""
BOLT_ADMIN_SETUP_TOKEN=""
# Los antiguos BOLT_ADMIN_EMAIL y BOLT_ADMIN_PASSWORD no autorizan el alta en producción.

# Buscador por foto. Configurar la clave únicamente en el servidor.
BOLT_PHOTO_SEARCH_ENABLED=false
BOLT_PHOTO_SEARCH_OPENAI_API_KEY=""
BOLT_PHOTO_SEARCH_MODEL="gpt-5.4-nano"
BOLT_PHOTO_SEARCH_REQUESTS_PER_MINUTE=5
BOLT_PHOTO_SEARCH_DAILY_LIMIT=100

# Solo en el backend operativo. Configure el receptor HTTPS de guardia en el gestor de secretos.
BOLT_ALERT_WEBHOOK_URL=""
BOLT_ALERT_COOLDOWN_SECONDS=300
