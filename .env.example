# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Public key for Google Maps Javascript API
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# BOLT_ADMIN_EMAIL: Correo opcional para auto-aprovisionar cuenta administradora al recrear despliegues
# BOLT_ADMIN_PASSWORD: Clave opcional para auto-aprovisionar cuenta administradora al recrear despliegues
# BOLT_ADMIN_NAME: Nombre opcional para el administrador
BOLT_ADMIN_EMAIL="admin@bolt.pet"
BOLT_ADMIN_PASSWORD=""
BOLT_ADMIN_NAME="Administrador Bolt Pets"

# Buscador por foto. Configurar la clave únicamente en el servidor.
BOLT_PHOTO_SEARCH_ENABLED=false
BOLT_PHOTO_SEARCH_OPENAI_API_KEY=""
BOLT_PHOTO_SEARCH_MODEL="gpt-5.4-nano"
BOLT_PHOTO_SEARCH_REQUESTS_PER_MINUTE=5
BOLT_PHOTO_SEARCH_DAILY_LIMIT=100
